# Copy to .env (git-ignored) before running the app: cp .env.example .env
# Settings are read by simulation_backend/settings.py via python-dotenv, and a
# value in .env overrides one already set in the shell.

# Required. Any non-empty string works for local development; generate a real
# one for anything deployed:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-change-me

# Optional, comma-separated. Leave blank for localhost/127.0.0.1 only.
ALLOWED_HOSTS=localhost,127.0.0.1
